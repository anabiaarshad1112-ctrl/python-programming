 For loop example
for i in range(5):
    print("Loop iteration", i)

# While loop example
count = 0
while count < 3:
    print("Count is", count)
    count += 1

# Loop with list and conditional break
numbers = [10, 20, 30, 40]
for num in numbers:
    if num == 30:
        print("Found 30, stopping loop")
        break
    print("Number:", num)

# Loop with continue
for i in range(6):
    if i % 2 == 0:
        continue
    print("Odd number:", i)

# Nested loops
for outer in range(3):
    for inner in range(2):
        print(f"Outer={outer}, Inner={inner}")

# For-else example
for i in range(3):
    print("Checking", i)
else:
    print("Loop completed normally")

# While-else example
count = 0
while count < 3:
    print("Counting", count)
    count += 1
else:
    print("While loop completed normally")


